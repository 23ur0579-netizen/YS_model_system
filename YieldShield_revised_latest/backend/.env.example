# Copy to .env, fill in real values, and NEVER commit the real file.
# Load with: export $(grep -v '^#' .env | xargs)   (or python-dotenv, direnv)

# --- Database (yieldshield_app role — created by 02_security.sql) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=yieldshield
PGUSER=yieldshield_app
PGPASSWORD=123

# Require a verified TLS connection (matches pg_hba.conf hostssl rules)
PGSSLMODE=disable
PGSSLROOTCERT=/path/to/ca.crt

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Outbound email (forgot-password link, registration approval, credentials) ---
# Sent via Brevo's REST API (https://api.brevo.com) over HTTPS — not SMTP,
# since SMTP ports (25/465/587) are commonly blocked by venue/campus wifi
# and mobile hotspots (this is what broke email during a live demo).
#   1. Create a free account at https://app.brevo.com (300 emails/day,
#      no credit card, no expiry).
#   2. Verify a sender email or domain: Senders, Domains & Dedicated IPs.
#      EMAIL_FROM below must be that verified address.
#   3. SMTP & API -> API Keys -> Generate a new API key -> paste below.
# Leave BREVO_API_KEY blank in local dev instead — the email content is
# logged to the console rather than sent, so the flow is still testable
# without touching a real inbox.
BREVO_API_KEY=
EMAIL_FROM=yield.shield1@gmail.com
EMAIL_FROM_NAME=YieldShield

# Frontend origin — used to build the reset-password link, and for CORS.
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Web Push (device notifications) ---
# Free, browser-native — no third-party account or API key. Generate
# with: python3 scripts/04_generate_vapid_keys.py
# (it writes the private key to vapid_private_key.pem and prints the
# two lines below). Leave both blank to run without device
# notifications — in-app notifications still work fine either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=
VAPID_CLAIM_EMAIL=mailto:yield.shield1@gmail.com
