# Copy to .env, fill in real values, and NEVER commit the real file.
# Load with: export $(grep -v '^#' .env | xargs)   (or python-dotenv, direnv)

# --- Database (yieldshield_app role — created by 02_security.sql) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=yieldshield
PGUSER=yieldshield_app
PGPASSWORD=123

# Require a verified TLS connection (matches pg_hba.conf hostssl rules)
PGSSLMODE=disable
PGSSLROOTCERT=/path/to/ca.crt

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Outbound email (forgot-password link) ---
# Sends via the project's Gmail account, yield.shield1@gmail.com.
# Gmail rejects SMTP login with the normal account password — you must
# generate a 16-character App Password instead:
#   1. Turn on 2-Step Verification on yield.shield1@gmail.com (Google
#      Account -> Security) if it isn't already on; App Passwords are
#      unavailable without it.
#   2. Google Account -> Security -> 2-Step Verification -> App
#      passwords -> create one (name it e.g. "YieldShield backend").
#   3. Paste the 16-character password below as SMTP_PASSWORD (spaces
#      Google shows in it don't matter either way).
# Leave SMTP_HOST blank in local dev instead — the reset link is
# logged to the console rather than emailed, so the flow is still
# testable without touching the real inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yield.shield1@gmail.com
SMTP_PASSWORD=jopl pkis vubz rihz
SMTP_FROM=yield.shield1@gmail.com
SMTP_USE_TLS=true

# Frontend origin — used to build the reset-password link, and for CORS.
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

ETL_PGUSER=yieldshield_etl
ETL_PGPASSWORD=123

# --- Web Push (device notifications) ---
# Free, browser-native — no third-party account or API key. Generate
# with: python3 scripts/04_generate_vapid_keys.py
# (it writes the private key to vapid_private_key.pem and prints the
# two lines below). Leave both blank to run without device
# notifications — in-app notifications still work fine either way.
VAPID_PUBLIC_KEY=BECI-W7XBYiVfnypANEeiafD6-BxPLajWwOvB23QFVXoDZPaAtmt1bK0UZ3-3Ore7yiaoFmIVdaSwQylK3iuBbo
VAPID_PRIVATE_KEY_FILE=C:\Users\tyron\Desktop\YS_model_system\yieldshield_revised_latest\backend\vapid_private_key.pem
VAPID_CLAIM_EMAIL=mailto:yield.shield1@gmail.com

